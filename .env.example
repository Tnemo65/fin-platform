# Mặc định dùng SQLite tại data/finplat.db. Production nên dùng PostgreSQL:
# DATABASE_URL=postgresql+psycopg://finplat:finplat@localhost:5432/finplat
# DATA_DIR=./data            # nơi để DB SQLite, raw/, reports/
# RAW_DIR=./data/raw
# API_URL=http://localhost:8000   # Streamlit gọi API ở đây
# Gửi báo cáo job lỗi lúc 19:00 (tuỳ chọn):
# NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/...
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
